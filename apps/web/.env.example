# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/formbuilder?schema=public"
# Em produção com Supabase: use Connection Pooler (porta 6543) + ?pgbouncer=true para evitar "max clients reached"

# NextAuth
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# SEO (opcional: em produção use a URL pública do site para canonical, sitemap e Open Graph)
# NEXT_PUBLIC_APP_URL="https://seudominio.com"

# Email (Resend)
AUTH_RESEND_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Form Builder <noreply@yourdomain.com>"

# Documentos: conversor .docx → PDF (Gotenberg). Local: docker compose up -d gotenberg
GOTENBERG_URL="http://localhost:3030"
# GOTENBERG_BASIC_AUTH="usuario:senha"

# Documentos: storage dos templates/PDFs (Supabase Storage, bucket privado).
# Sem estas variáveis, em dev os arquivos vão para apps/web/.storage/.
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# STORAGE_BUCKET="documents"

# Documentos: segredo do cron /api/cron/documents (Vercel envia como Bearer)
# CRON_SECRET="gere-com-openssl-rand-hex-32"

# Stripe — planos à venda (crie os produtos em BRL e cole os price IDs)
# STRIPE_SECRET_KEY="sk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_DOCS_PRO_PRICE_ID="price_..."
# NEXT_PUBLIC_STRIPE_DOCS_UNLIMITED_PRICE_ID="price_..."
# Legados (Plus/Premium): mantenha enquanto houver assinantes, para o webhook reconhecê-los
# NEXT_PUBLIC_STRIPE_PLUS_PRICE_ID="price_..."
# NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID="price_..."
# NEXT_PUBLIC_STRIPE_DOCS_PRO_YEARLY_PRICE_ID="price_..."
# NEXT_PUBLIC_STRIPE_DOCS_UNLIMITED_YEARLY_PRICE_ID="price_..."

# Área admin (/admin): e-mails separados por vírgula
# ADMIN_EMAILS="voce@exemplo.com"
